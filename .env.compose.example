# Local Docker Compose defaults. Replace every password before shared use.
POSTGRES_PASSWORD=intentguard-local-change-me
KEYCLOAK_ADMIN_PASSWORD=keycloak-local-change-me
KEYCLOAK_CONNECTOR_CLIENT_SECRET=intentguard-connector-local-secret
GRAFANA_ADMIN_PASSWORD=intentguard-local-change-me

# Browser-facing URLs must use localhost; container-to-container URLs are set
# directly in docker-compose.yml.
INTENTGUARD_PUBLIC_API_URL=http://localhost:8000
INTENTGUARD_JWT_ISSUER=http://localhost:8080/realms/intentguard
INTENTGUARD_CORS_ORIGINS=http://localhost:3000
