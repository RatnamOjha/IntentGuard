# Environment variables read by the IntentGuard operator console.
#
# Source of truth: prototype/lib/intentguard-api.ts.

# Base URL of the FastAPI governance gateway. Defaults to http://127.0.0.1:8000.
NEXT_PUBLIC_INTENTGUARD_API_URL=http://127.0.0.1:8000

# The build also reads three tool-owned variables that are set for you and are
# not application configuration, so they are deliberately not listed above:
#   WRANGLER_LOG_PATH, MINIFLARE_REGISTRY_PATH  - defaulted in vite.config.ts
#                                                 and the package.json scripts.
#   CODEX_SANDBOX                               - set by the sandbox itself to
#                                                 switch Vite to polling HMR.
