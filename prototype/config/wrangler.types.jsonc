// Type-generation source only. Deliberately NOT at the project root.
//
// @cloudflare/vite-plugin auto-detects a wrangler config in the project root
// and merges it with the inline `localBindingConfig` from vite.config.ts, which
// duplicates compatibility flags and stops the dev runtime from starting. The
// inline object is the real configuration; this file exists purely so
// `wrangler types` has something to read.
//
// Regenerate with: pnpm run types
{
  "name": "intentguard-prototype",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"]
}
