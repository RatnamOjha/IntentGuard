# Environment variables read by the IntentGuard governance API.
#
# THIS FILE IS COMMITTED. Never put a real secret here -- keep the values blank.
# Copy it to .env, which is gitignored, and put real values there:
#
#     cp .env.example .env
#
# scripts/start-demo.sh, the intentguard-api console script, and
# examples/chat.py all load .env automatically. Variables already exported in
# your shell take precedence over the file.
#
# Source of truth: src/intentguard/api.py (`configured_cors_origins`). This is
# the only variable the Python package reads. The operator console has its own
# example file at prototype/.env.example.

# Provider keys are optional. Without one, the agent uses the deterministic
# scripted planner so demos and tests need no network.
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Override the provider ("openai", "xai", or "groq"). Normally inferred from
# the key prefix. INTENTGUARD_LLM_API_KEY is a provider-neutral alternative.
INTENTGUARD_LLM_API_KEY=
INTENTGUARD_LLM_PROVIDER=

# Override provider defaults and bound reliability behavior.
INTENTGUARD_LLM_MODEL=
INTENTGUARD_LLM_TIMEOUT_SECONDS=30
INTENTGUARD_LLM_MAX_RETRIES=2
INTENTGUARD_LLM_MAX_TOOL_CALLS=1

# Operator-supplied rates keep cost telemetry accurate as provider prices move.
INTENTGUARD_LLM_INPUT_COST_PER_MILLION=0
INTENTGUARD_LLM_OUTPUT_COST_PER_MILLION=0

# Structured JSON logs, W3C traces, and OTLP/HTTP export. Leave the endpoint
# blank to keep spans in-process; the local observability stack listens on 4318.
INTENTGUARD_LOG_LEVEL=INFO
INTENTGUARD_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Comma-separated origins allowed to call the governance API from a browser.
# Unset falls back to the local console ports 3000, 3001, and 5173 on both
# localhost and 127.0.0.1.
INTENTGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Apply migrations 0001 through 0005 before enabling PostgreSQL.
# Leave blank to use the in-memory demo/test backends.
INTENTGUARD_DATABASE_URL=

# Abuse controls. Set a Redis URL to make rate windows atomic across gateway
# replicas; without it the same algorithm remains process-local for demos.
INTENTGUARD_REDIS_URL=
INTENTGUARD_RATE_WINDOW_SECONDS=60
INTENTGUARD_AGENT_RATE_LIMIT=300
INTENTGUARD_CUSTOMER_RATE_LIMIT=180
INTENTGUARD_OPERATOR_RATE_LIMIT=180
INTENTGUARD_CONNECTOR_RATE_LIMIT=600
INTENTGUARD_MAX_REQUEST_BODY_BYTES=1048576
INTENTGUARD_MAX_OUTSTANDING_RESERVATIONS=20
INTENTGUARD_MAX_PENDING_APPROVALS=500
INTENTGUARD_MAX_AUDIT_PAGE_SIZE=200
INTENTGUARD_AUDIT_ARCHIVE_AFTER_DAYS=365

# Signed customer-intent verification. Audience defaults to intentguard-api.
# Optional comma-separated issuer allowlist; keys remain independently bound to
# their issuer in the registry even when this is blank.
INTENTGUARD_INTENT_AUDIENCE=intentguard-api
INTENTGUARD_INTENT_ISSUERS=http://127.0.0.1:9100

# Execution-lease signing and the protected booking connector. With PostgreSQL,
# an ephemeral gateway key is published automatically when no private key is set.
INTENTGUARD_LEASE_PRIVATE_KEY=
INTENTGUARD_LEASE_ISSUER=intentguard-gateway
INTENTGUARD_LEASE_AUDIENCE=intentguard-booking-connector
# Official OPA CLI used for Rego validation, dry runs, comparisons, and runtime
# decisions. The local installer places it at .tools/opa.exe automatically.
INTENTGUARD_OPA_EXECUTABLE=.tools/opa.exe
# Either provide a fixed short-lived connector token for local scripts, or
# configure OAuth client credentials so the service refreshes tokens itself.
INTENTGUARD_CONNECTOR_ACCESS_TOKEN=
INTENTGUARD_OAUTH_TOKEN_URL=
INTENTGUARD_OAUTH_CLIENT_ID=
INTENTGUARD_OAUTH_CLIENT_SECRET=
INTENTGUARD_API_URL=http://127.0.0.1:8000
INTENTGUARD_CONNECTOR_PORT=8100
INTENTGUARD_CONNECTOR_GATEWAY_TIMEOUT_SECONDS=5
INTENTGUARD_CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=3
INTENTGUARD_CONNECTOR_CIRCUIT_RECOVERY_SECONDS=30

# RS256 access-token validation. Defaults point at the loopback-only issuer in
# examples/local_jwks_server.py. Override all three for Keycloak or another IdP.
INTENTGUARD_JWT_ISSUER=http://127.0.0.1:9000
INTENTGUARD_JWT_AUDIENCE=intentguard-api
INTENTGUARD_JWKS_URL=http://127.0.0.1:9000/.well-known/jwks.json
