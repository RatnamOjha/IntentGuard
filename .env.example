# Environment variables read by the IntentGuard governance API.
#
# Source of truth: src/intentguard/api.py (`configured_cors_origins`). This is
# the only variable the Python package reads. The operator console has its own
# example file at prototype/.env.example.

# API key for the conversational agent. Optional: without one the agent falls
# back to a deterministic scripted planner, so the demo and the tests run with
# no key and no network. Source: src/intentguard/agent.py.
#
# Two different companies with confusingly similar names are both supported,
# and the provider is inferred from the key prefix:
#   xAI (Grok)  keys start with "xai-"  -> https://api.x.ai/v1
#   Groq        keys start with "gsk_"  -> https://api.groq.com/openai/v1
# Set whichever you have. INTENTGUARD_LLM_API_KEY works for either.
XAI_API_KEY=
GROQ_API_KEY=

# Override the inferred provider ("xai" or "groq") if the prefix is ambiguous.
INTENTGUARD_LLM_PROVIDER=

# Override the model. Defaults per provider: grok-4.6 for xAI,
# llama-3.3-70b-versatile for Groq.
INTENTGUARD_LLM_MODEL=

# Comma-separated origins allowed to call the governance API from a browser.
# Unset falls back to the local console ports 3000, 3001, and 5173 on both
# localhost and 127.0.0.1.
INTENTGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
